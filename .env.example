# ── Maps ──────────────────────────────────────────────────────────────
# Public token (pk.*) from https://account.mapbox.com — restrict it to your
# domains (localhost + your Vercel domain). Without it, maps fall back to the sketch style.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: your own Mapbox Studio style
# NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/outdoors-v12

# ── Photo storage ─────────────────────────────────────────────────────
# supabase → public bucket in your Supabase project (required for production builds)
# local    → files in /public/photos, dev only (fill with `pnpm photos pull` to work offline)
NEXT_PUBLIC_PHOTO_STORAGE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_BUCKET=hikes
# Only used by `pnpm ingest` / `pnpm photos push|pull` on your machine. Never add this to Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# ── Guides and the editor (V2 E2) ─────────────────────────────────────
# Where guides are read from and saved to:
#   local    → files in content/hikes (default; `pnpm dev`, tests)
#   supabase → the database. Needs SUPABASE_SERVICE_ROLE_KEY (server-only).
CONTENT_STORE=local
# Who may use /editor:
#   (unset)  → `pnpm dev`: a local owner, no sign-in. Anywhere else: nobody (404).
#   supabase → Google sign-in through Supabase Auth; only people in the `editors` table.
#   off      → nobody, even in dev.
# EDITOR_AUTH=supabase
# Public key for the sign-in session (safe in the browser; row-level security gives it nothing).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
