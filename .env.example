# ── Site ──────────────────────────────────────────────────────────────
# The site's public address, for the sitemap and social cards. On Vercel it defaults to the
# project's production domain; set it once the site has its own domain.
# NEXT_PUBLIC_SITE_URL=https://example.com

# ── Maps ──────────────────────────────────────────────────────────────
# Public token (pk.*) from https://account.mapbox.com — restrict it to your
# domains (localhost + your Vercel domain). Without it, maps fall back to the sketch style.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: your own Mapbox Studio style
# NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/outdoors-v12

# ── Photo storage ─────────────────────────────────────────────────────
# supabase → public bucket in your Supabase project (required for production builds)
# local    → files in /public/photos, dev only (fill with `pnpm photos pull` to work offline)
NEXT_PUBLIC_PHOTO_STORAGE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_BUCKET=hikes
# Secret: it bypasses every Supabase rule. Only the photo scripts on your machine use it, to upload
# to Storage (`pnpm photos push|pull`, `pnpm ingest --storage supabase`). The site doesn't need it.
# Never give it a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=

# ── Guides and the editor ─────────────────────────────────────────────
# Where guides are read from and saved to:
#   local    → files in content/hikes (default; `pnpm dev`, tests)
#   postgres → the database through Drizzle (src/db). Needs DATABASE_URL.
CONTENT_STORE=local
# Secret, server-only: the database's connection string, password included. With Supabase use the
# transaction pooler's (Project → Connect → Transaction pooler, port 6543): it works from Vercel.
# Used with CONTENT_STORE=postgres, with EDITOR_AUTH=supabase (the editors list), by
# `--store postgres` / `--guides postgres`, `pnpm editors` and `pnpm db:migrate`.
# In Vercel add it as a Sensitive variable.
# DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Who may use /editor:
#   (unset)  → `pnpm dev`: a local owner, no sign-in. Anywhere else: nobody (404).
#   supabase → Google sign-in through Supabase Auth; only people in the `editors` table.
#   off      → nobody, even in dev.
# EDITOR_AUTH=supabase
# Public key for the sign-in session (safe in the browser; row-level security gives it nothing).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
